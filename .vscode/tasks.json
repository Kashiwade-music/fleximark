// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "process",
      "command": "mise",
      "args": ["run", "watch"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$esbuild-watch",
        "$tsc-watch",
        {
          "owner": "fleximark-dev",
          "pattern": {
            "regexp": "^(?!)$"
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^FlexiMark VS Code watch starting$",
            "endsPattern": "^FlexiMark VS Code watch ready$"
          }
        }
      ],
      "isBackground": true,
      "label": "mise: watch",
      "presentation": {
        "group": "watch",
        "reveal": "never"
      }
    }
  ]
}
