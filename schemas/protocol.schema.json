                "method": { "const": "fleximark/closeDocument" },
                "params": { "$ref": "#/$defs/closeDocumentParams" }
              }
            }
          ]
        }
      ]
    },
    "customNotification": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/notificationBase" },
            {
              "properties": {
                "method": { "const": "fleximark/requestFullText" },
                "params": { "$ref": "#/$defs/requestFullTextParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/notificationBase" },
            {
              "properties": {
                "method": { "const": "fleximark/previewEvent" },
                "params": { "$ref": "#/$defs/previewEventParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/notificationBase" },
            {
              "properties": {
                "method": { "const": "fleximark/setSelection" },
                "params": { "$ref": "#/$defs/selectionParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/notificationBase" },
            {
              "properties": {
                "method": { "const": "fleximark/setViewport" },
                "params": { "$ref": "#/$defs/viewportParams" }
              }
            }
          ]
        }
      ]
    },
    "lspMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": {
          "enum": [
            "initialize",
            "initialized",
            "shutdown",
            "exit",
            "textDocument/didOpen",
            "textDocument/didChange",
            "textDocument/didClose",
            "textDocument/completion",
            "textDocument/hover",
            "textDocument/documentSymbol",
            "textDocument/codeAction",
            "textDocument/diagnostic"
          ]
        },
        "params": { "$ref": "#/$defs/jsonValue" }
      },
      "required": ["jsonrpc", "method"]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/initializeResult" },
            { "$ref": "#/$defs/attachDocumentResult" },
            { "$ref": "#/$defs/checkpointDocumentResult" },
            { "$ref": "#/$defs/renderPublication" },
            { "$ref": "#/$defs/createPreviewResult" },
            { "$ref": "#/$defs/commandResult" },
            { "$ref": "#/$defs/jsonValue" }
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "data": { "$ref": "#/$defs/jsonValue" }
          },
          "required": ["code", "message"]
        }
      },
      "required": ["jsonrpc", "id"],
      "oneOf": [{ "required": ["result"] }, { "required": ["error"] }]
    },
    "methodResults": {
      "type": "object",
      "description": "Named result DTOs for every FlexiMark method.",
      "properties": {
        "fleximark/initialize": { "$ref": "#/$defs/initializeResult" },
        "fleximark/attachDocument": {
          "$ref": "#/$defs/attachDocumentResult"
        },
        "fleximark/checkpointDocument": {
          "$ref": "#/$defs/checkpointDocumentResult"
        },
        "fleximark/render": { "$ref": "#/$defs/renderPublication" },
        "fleximark/createPreview": {
          "$ref": "#/$defs/createPreviewResult"
        },
        "fleximark/disposePreview": { "type": "null" },
        "fleximark/setSelection": { "type": "null" },
        "fleximark/setViewport": { "type": "null" },
        "fleximark/previewEvent": { "type": "null" },
        "fleximark/reloadPreview": { "type": "null" },
        "fleximark/getNoteOptions": {
          "$ref": "#/$defs/getNoteOptionsResult"
        },
        "fleximark/reconfigureWorkspace": { "type": "null" },
        "fleximark/executeCommand": { "$ref": "#/$defs/commandResult" },
        "fleximark/openDocument": {
          "$ref": "#/$defs/attachDocumentResult"
        },
        "fleximark/changeDocument": {
          "$ref": "#/$defs/checkpointDocumentResult"
        },
        "fleximark/closeDocument": { "type": "null" }
      },
      "additionalProperties": false
    }
  }
