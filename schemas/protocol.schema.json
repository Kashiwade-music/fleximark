{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleximark.dev/schemas/protocol-v1.json",
  "title": "FlexiMark JSON-RPC protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/customRequest" },
    { "$ref": "#/$defs/customNotification" },
    { "$ref": "#/$defs/lspMessage" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "id": { "type": ["integer", "string"] },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": { "type": "integer", "minimum": 0 },
        "character": { "type": "integer", "minimum": 0 }
      },
      "required": ["line", "character"]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/position" },
        "end": { "$ref": "#/$defs/position" }
      },
      "required": ["start", "end"]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchor": { "$ref": "#/$defs/position" },
        "active": { "$ref": "#/$defs/position" }
      },
      "required": ["anchor", "active"]
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeExists": { "const": true },
        "currentParentId": { "type": "string", "minLength": 1 }
      },
      "required": ["nodeExists", "currentParentId"]
    },
    "patchOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "insert" },
            "nodeId": { "type": "string" },
            "parentId": { "type": "string" },
            "beforeId": { "type": ["string", "null"] },
            "afterId": { "type": ["string", "null"] },
            "atEnd": { "type": "boolean" },
            "content": { "type": "string" },
            "contentNodeIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            }
          },
          "required": [
            "type",
            "nodeId",
            "parentId",
            "beforeId",
            "afterId",
            "atEnd",
            "content",
            "contentNodeIds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "remove" },
            "nodeId": { "type": "string" },
            "parentId": { "type": "string" },
            "precondition": { "$ref": "#/$defs/precondition" }
          },
          "required": ["type", "nodeId", "parentId", "precondition"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "replace" },
            "nodeId": { "type": "string" },
            "parentId": { "type": "string" },
            "content": { "type": "string" },
            "contentNodeIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "precondition": { "$ref": "#/$defs/precondition" }
          },
          "required": [
            "type",
            "nodeId",
            "parentId",
            "content",
            "contentNodeIds",
            "precondition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "move" },
            "nodeId": { "type": "string" },
            "parentId": { "type": "string" },
            "beforeId": { "type": ["string", "null"] },
            "afterId": { "type": ["string", "null"] },
            "atEnd": { "type": "boolean" },
            "precondition": { "$ref": "#/$defs/precondition" }
          },
          "required": [
            "type",
            "nodeId",
            "parentId",
            "beforeId",
            "afterId",
            "atEnd",
            "precondition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "setAttributes" },
            "nodeId": { "type": "string" },
            "parentId": { "type": "string" },
            "attributes": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "role",
                  "aria-checked",
                  "open",
                  "class",
                  "data-line-numbers",
                  "data-admonition-kind"
                ]
              },
              "additionalProperties": {
                "oneOf": [
                  { "type": "string", "maxLength": 4096 },
                  { "type": "null" }
                ]
              }
            },
            "precondition": { "$ref": "#/$defs/precondition" }
          },
          "required": [
            "type",
            "nodeId",
            "parentId",
            "attributes",
            "precondition"
          ]
        }
      ]
    },
    "sourcePosition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": { "type": "integer", "minimum": 0 },
        "character": { "type": "integer", "minimum": 0 },
        "encoding": { "enum": ["utf8", "utf16", "utf32"] }
      },
      "required": ["line", "character", "encoding"]
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "byteStart": { "type": "integer", "minimum": 0 },
        "byteEnd": { "type": "integer", "minimum": 0 },
        "start": { "$ref": "#/$defs/sourcePosition" },
        "end": { "$ref": "#/$defs/sourcePosition" }
      },
      "required": ["byteStart", "byteEnd", "start", "end"]
    },
    "navigationEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "sourceRange": { "$ref": "#/$defs/sourceRange" },
        "depth": { "type": "integer", "minimum": 0 }
      },
      "required": ["nodeId", "sourceRange", "depth"]
    },
    "navigation": {
      "type": "array",
      "items": { "$ref": "#/$defs/navigationEntry" }
    },
    "renderStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "css": { "type": "string" },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["css", "fingerprint"]
    },
    "renderAsset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^fleximark-asset:[0-9a-f]{64}$"
        },
        "mediaType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp",
            "audio/mpeg",
            "audio/ogg",
            "audio/wav"
          ]
        },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byteLength": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "data": { "type": "string", "contentEncoding": "base64" }
      },
      "required": [
        "reference",
        "mediaType",
        "contentHash",
        "byteLength",
        "data"
      ]
    },
    "renderSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "full" },
        "previewSessionId": { "type": "string" },
        "documentVersion": { "type": "integer", "minimum": 0 },
        "resultRenderRevision": { "type": "integer", "minimum": 1 },
        "rendererFingerprint": { "type": "string" },
        "nodeIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "navigation": { "$ref": "#/$defs/navigation" },
        "style": {
          "oneOf": [{ "$ref": "#/$defs/renderStyle" }, { "type": "null" }]
        },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/renderAsset" }
        },
        "html": { "type": "string" }
      },
      "required": [
        "type",
        "previewSessionId",
        "documentVersion",
        "resultRenderRevision",
        "rendererFingerprint",
        "nodeIds",
        "navigation",
        "style",
        "assets",
        "html"
      ]
    },
    "renderPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "const": "patch" },
        "previewSessionId": { "type": "string" },
        "documentVersion": { "type": "integer", "minimum": 0 },
        "baseRenderRevision": { "type": "integer", "minimum": 1 },
        "resultRenderRevision": { "type": "integer", "minimum": 1 },
        "baseRendererFingerprint": { "type": "string" },
        "resultRendererFingerprint": { "type": "string" },
        "navigation": { "$ref": "#/$defs/navigation" },
        "style": {
          "oneOf": [{ "$ref": "#/$defs/renderStyle" }, { "type": "null" }]
        },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/patchOperation" }
        }
      },
      "required": [
        "type",
        "previewSessionId",
        "documentVersion",
        "baseRenderRevision",
        "resultRenderRevision",
        "baseRendererFingerprint",
        "resultRendererFingerprint",
        "navigation",
        "style",
        "operations"
      ]
    },
    "renderPublication": {
      "oneOf": [
        { "$ref": "#/$defs/renderSnapshot" },
        { "$ref": "#/$defs/renderPatch" }
      ]
    },
    "previewNavigationEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "selectNode" },
            "previewSessionId": { "type": "string", "minLength": 1 },
            "renderRevision": { "type": "integer", "minimum": 1 },
            "nodeId": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "previewSessionId", "renderRevision", "nodeId"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "revealNode" },
            "previewSessionId": { "type": "string", "minLength": 1 },
            "renderRevision": { "type": "integer", "minimum": 1 },
            "nodeId": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "previewSessionId", "renderRevision", "nodeId"]
        }
      ]
    },
    "sourceNavigationEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "selectSource" },
            "sourceRange": { "$ref": "#/$defs/sourceRange" }
          },
          "required": ["type", "sourceRange"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "revealSource" },
            "sourceRange": { "$ref": "#/$defs/sourceRange" }
          },
          "required": ["type", "sourceRange"]
        }
      ]
    },
    "renderNavigationEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "selection" },
            "previewSessionId": { "type": "string", "minLength": 1 },
            "renderRevision": { "type": "integer", "minimum": 1 },
            "nodeIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "required": ["type", "previewSessionId", "renderRevision", "nodeIds"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "viewport" },
            "previewSessionId": { "type": "string", "minLength": 1 },
            "renderRevision": { "type": "integer", "minimum": 1 },
            "nodeId": { "type": "string", "minLength": 1 }
          },
          "required": ["type", "previewSessionId", "renderRevision", "nodeId"]
        }
      ]
    },
    "initializeParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": { "const": 1 },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          },
          "required": ["name", "version"]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "embeddedHtml": { "type": "boolean" },
            "structuredPreview": { "type": "boolean" },
            "selectionEvents": { "type": "boolean" },
            "viewportEvents": { "type": "boolean" },
            "openExternal": { "type": "boolean" }
          }
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "uri": { "type": "string" },
              "trusted": { "type": "boolean" }
            },
            "required": ["uri", "trusted"]
          }
        }
      },
      "required": ["protocolVersion", "client"]
    },
    "initializeResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocolVersion": { "const": 1 },
        "daemonInstanceId": { "type": "string" },
        "workspaceStatuses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "uri": { "type": "string" },
              "enabled": { "type": "boolean" },
              "error": { "type": "string" }
            },
            "required": ["uri", "enabled"]
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "htmlRender": { "type": "boolean" },
            "documentCheckpoint": { "type": "boolean" },
            "selectionEvents": { "type": "boolean" },
            "viewportEvents": { "type": "boolean" },
            "workspaceCommands": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": [
            "htmlRender",
            "documentCheckpoint",
            "selectionEvents",
            "viewportEvents",
            "workspaceCommands"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "daemonInstanceId",
        "workspaceStatuses",
        "capabilities"
      ]
    },
    "attachDocumentParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "uri": { "type": "string" },
        "expectedDocumentVersion": { "type": "integer" },
        "contentHash": { "type": "string" }
      },
      "required": [
        "daemonInstanceId",
        "uri",
        "expectedDocumentVersion",
        "contentHash"
      ]
    },
    "attachDocumentResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentSessionId": { "type": "string" },
        "documentVersion": { "type": "integer" },
        "contentHash": { "type": "string" }
      },
      "required": ["documentSessionId", "documentVersion", "contentHash"]
    },
    "checkpointDocumentParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "documentSessionId": { "type": "string" },
        "documentVersion": { "type": "integer" },
        "contentHash": { "type": "string" }
      },
      "required": [
        "daemonInstanceId",
        "documentSessionId",
        "documentVersion",
        "contentHash"
      ]
    },
    "checkpointDocumentResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentVersion": { "type": "integer" },
        "contentHash": { "type": "string" }
      },
      "required": ["documentVersion", "contentHash"]
    },
    "renderParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "documentSessionId": { "type": "string" },
        "documentVersion": { "type": "integer" }
      },
      "required": ["daemonInstanceId", "documentSessionId", "documentVersion"]
    },
    "createPreviewParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "documentSessionId": { "type": "string" },
        "expectedDocumentVersion": { "type": "integer" },
        "target": { "enum": ["embeddedHtml", "externalBrowser"] }
      },
      "required": [
        "daemonInstanceId",
        "documentSessionId",
        "expectedDocumentVersion",
        "target"
      ]
    },
    "createPreviewResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previewSessionId": { "type": "string" },
        "url": { "type": "string" },
        "initialPublication": { "$ref": "#/$defs/renderSnapshot" }
      },
      "required": ["previewSessionId", "initialPublication"]
    },
    "previewSessionParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "previewSessionId": { "type": "string" }
      },
      "required": ["daemonInstanceId", "previewSessionId"]
    },
    "selectionParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "documentSessionId": { "type": "string" },
        "expectedDocumentVersion": { "type": "integer" },
        "selections": {
          "type": "array",
          "items": { "$ref": "#/$defs/selection" }
        }
      },
      "required": [
        "daemonInstanceId",
        "documentSessionId",
        "expectedDocumentVersion",
        "selections"
      ]
    },
    "viewportParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "documentSessionId": { "type": "string" },
        "expectedDocumentVersion": { "type": "integer" },
        "ranges": {
          "type": "array",
          "items": { "$ref": "#/$defs/range" }
        }
      },
      "required": [
        "daemonInstanceId",
        "documentSessionId",
        "expectedDocumentVersion",
        "ranges"
      ]
    },
    "previewEventParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "previewSessionId": { "type": "string" },
        "renderRevision": { "type": "integer", "minimum": 1 },
        "event": {
          "anyOf": [
            { "$ref": "#/$defs/renderPublication" },
            { "$ref": "#/$defs/previewNavigationEvent" },
            { "$ref": "#/$defs/sourceNavigationEvent" },
            { "$ref": "#/$defs/renderNavigationEvent" }
          ]
        }
      },
      "required": [
        "daemonInstanceId",
        "previewSessionId",
        "renderRevision",
        "event"
      ]
    },
    "executeCommandParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "command": { "type": "string" },
        "documentSessionId": { "type": "string" },
        "expectedDocumentVersion": { "type": "integer" },
        "workspaceUri": { "type": "string" },
        "destinationUri": { "type": "string" },
        "noteCategory": { "type": "string" },
        "noteTemplate": { "type": "string" }
      },
      "required": ["daemonInstanceId", "command"]
    },
    "getNoteOptionsParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "workspaceUri": { "type": "string" }
      },
      "required": ["daemonInstanceId", "workspaceUri"]
    },
    "reconfigureWorkspaceParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "workspaceUri": { "type": "string" },
        "trusted": { "type": "boolean" }
      },
      "required": ["daemonInstanceId", "workspaceUri", "trusted"]
    },
    "getNoteOptionsResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "categories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "templates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      },
      "required": ["categories", "templates"]
    },
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": { "enum": ["info", "warning", "error"] },
            "text": { "type": "string" }
          },
          "required": ["level", "text"]
        },
        "openUri": { "type": "string" }
      }
    },
    "openDocumentParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "uri": { "type": "string" },
        "documentVersion": { "type": "integer" },
        "text": { "type": "string" }
      },
      "required": ["daemonInstanceId", "uri", "documentVersion", "text"]
    },
    "changeDocumentParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "documentSessionId": { "type": "string" },
        "baseDocumentVersion": { "type": "integer" },
        "baseContentHash": { "type": "string" },
        "documentVersion": { "type": "integer" },
        "text": { "type": "string" }
      },
      "required": [
        "daemonInstanceId",
        "documentSessionId",
        "baseDocumentVersion",
        "baseContentHash",
        "documentVersion",
        "text"
      ]
    },
    "requestFullTextParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "uri": { "type": "string" },
        "documentSessionId": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["daemonInstanceId", "uri", "documentSessionId", "reason"]
    },
    "closeDocumentParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemonInstanceId": { "type": "string" },
        "documentSessionId": { "type": "string" }
      },
      "required": ["daemonInstanceId", "documentSessionId"]
    },
    "requestBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "type": "string" },
        "params": { "type": "object" }
      },
      "required": ["jsonrpc", "id", "method", "params"]
    },
    "notificationBase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "type": "string" },
        "params": { "type": "object" }
      },
      "required": ["jsonrpc", "method", "params"]
    },
    "customRequest": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "properties": {
                "method": { "const": "fleximark/initialize" },
                "params": { "$ref": "#/$defs/initializeParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "properties": {
                "method": { "const": "fleximark/attachDocument" },
                "params": { "$ref": "#/$defs/attachDocumentParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "properties": {
                "method": { "const": "fleximark/checkpointDocument" },
                "params": { "$ref": "#/$defs/checkpointDocumentParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "properties": {
                "method": { "const": "fleximark/render" },
                "params": { "$ref": "#/$defs/renderParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "properties": {
                "method": { "const": "fleximark/createPreview" },
                "params": { "$ref": "#/$defs/createPreviewParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "properties": {
                "method": {
                  "enum": [
                    "fleximark/disposePreview",
                    "fleximark/reloadPreview"
                  ]
                },
                "params": { "$ref": "#/$defs/previewSessionParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "properties": {
                "method": { "const": "fleximark/getNoteOptions" },
                "params": { "$ref": "#/$defs/getNoteOptionsParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "properties": {
                "method": { "const": "fleximark/reconfigureWorkspace" },
                "params": { "$ref": "#/$defs/reconfigureWorkspaceParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "properties": {
                "method": { "const": "fleximark/executeCommand" },
                "params": { "$ref": "#/$defs/executeCommandParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
            {
              "properties": {
                "method": { "const": "fleximark/openDocument" },
                "params": { "$ref": "#/$defs/openDocumentParams" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/requestBase" },
