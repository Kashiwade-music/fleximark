{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleximark.dev/schemas/plugin-manifest-v1.json",
  "title": "FlexiMark WASM plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "api_version": { "const": 1 },
        "required": { "type": "boolean", "default": false }
      },
      "required": ["id", "api_version"]
    },
    "capabilities": {
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "read_workspace": { "type": "boolean", "default": false },
        "write_workspace": { "type": "boolean", "default": false },
        "network": { "type": "boolean", "default": false },
        "environment": { "type": "boolean", "default": false },
        "unsafe_html_output": { "type": "boolean", "default": false }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wasm_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "required": ["wasm_sha256"]
    }
  },
  "required": ["schema_version", "plugin", "artifact"]
}
