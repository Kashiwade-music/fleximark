{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleximark.dev/schemas/feature-inventory-v1.json",
  "title": "FlexiMark current feature inventory",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "owner": {
            "enum": [
              "engine",
              "service",
              "adapter",
              "preview-client",
              "release"
            ]
          },
          "description": { "type": "string", "minLength": 1 }
        },
        "required": ["id", "owner"]
      }
    }
  },
  "required": ["schemaVersion", "capabilities"]
}
