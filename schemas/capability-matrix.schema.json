{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleximark.dev/schemas/capability-matrix-v1.json",
  "title": "FlexiMark release capability matrix",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
          "decision": { "enum": ["keep", "change", "remove"] },
          "owner": {
            "enum": [
              "engine",
              "service",
              "adapter",
              "preview-client",
              "release"
            ]
          },
          "baselineEvidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "contract": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "uniqueItems": true
          },
          "tests": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "uniqueItems": true
          },
          "cleanBreakId": { "type": "string", "minLength": 1 },
          "releaseNoteId": { "type": "string", "minLength": 1 }
        },
        "required": [
          "id",
          "decision",
          "owner",
          "baselineEvidence",
          "contract",
          "tests"
        ],
        "allOf": [
          {
            "if": {
              "properties": { "decision": { "enum": ["change", "remove"] } },
              "required": ["decision"]
            },
            "then": { "required": ["cleanBreakId", "releaseNoteId"] }
          }
        ]
      }
    }
  },
  "required": ["schemaVersion", "baseline", "capabilities"]
}
