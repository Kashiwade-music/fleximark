    "rootDir": ".",
    "outDir": "out/types/unit",
    "tsBuildInfoFile": "out/types/.tsbuildinfo/unit.tsbuildinfo"
  },
  "include": [
    "test/pure.test.mts",
    "test/adapter/async-helpers.mts",
    "test/adapter/adapter-preview-events.test.mts",
