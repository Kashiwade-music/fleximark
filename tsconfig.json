{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "mocha", "vscode", "trusted-types"],
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
  },
  "include": ["src", "media", "test"]
}
