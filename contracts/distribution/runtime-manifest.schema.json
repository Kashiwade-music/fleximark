{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleximark.dev/schemas/runtime-manifest.json",
  "title": "FlexiMark runtime manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protocolVersion": {
      "type": "integer",
      "minimum": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "target": {
      "enum": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc"
      ]
    },
    "files": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "protocolVersion",
    "version",
    "target",
    "files"
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unixFiles": {
      "type": "object",
      "properties": {
        "resources/preview/browser-host.js": {
          "$ref": "#/$defs/sha256"
        },
        "resources/preview/fleximark.css": {
          "$ref": "#/$defs/sha256"
        },
        "resources/preview/katex.css": {
          "$ref": "#/$defs/sha256"
        },
        "resources/workspace/workspace.js": {
          "$ref": "#/$defs/sha256"
        },
        "resources/workspace/workspace.css": {
          "$ref": "#/$defs/sha256"
        },
        "bin/fleximarkd": {
          "$ref": "#/$defs/sha256"
        },
        "bin/fleximark": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "resources/preview/browser-host.js",
        "resources/preview/fleximark.css",
        "resources/preview/katex.css",
        "resources/workspace/workspace.js",
        "resources/workspace/workspace.css",
        "bin/fleximarkd",
        "bin/fleximark"
      ],
      "additionalProperties": false
    },
    "windowsFiles": {
      "type": "object",
      "properties": {
        "resources/preview/browser-host.js": {
          "$ref": "#/$defs/sha256"
        },
        "resources/preview/fleximark.css": {
          "$ref": "#/$defs/sha256"
        },
        "resources/preview/katex.css": {
          "$ref": "#/$defs/sha256"
        },
        "resources/workspace/workspace.js": {
          "$ref": "#/$defs/sha256"
        },
        "resources/workspace/workspace.css": {
          "$ref": "#/$defs/sha256"
        },
        "bin/fleximarkd.exe": {
          "$ref": "#/$defs/sha256"
        },
        "bin/fleximark.exe": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "resources/preview/browser-host.js",
        "resources/preview/fleximark.css",
        "resources/preview/katex.css",
        "resources/workspace/workspace.js",
        "resources/workspace/workspace.css",
        "bin/fleximarkd.exe",
        "bin/fleximark.exe"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "target": {
          "enum": [
            "x86_64-unknown-linux-gnu",
            "aarch64-unknown-linux-gnu",
            "x86_64-apple-darwin",
            "aarch64-apple-darwin"
          ]
        },
        "files": {
          "$ref": "#/$defs/unixFiles"
        }
      }
    },
    {
      "properties": {
        "target": {
          "enum": ["x86_64-pc-windows-msvc", "aarch64-pc-windows-msvc"]
        },
        "files": {
          "$ref": "#/$defs/windowsFiles"
        }
      }
    }
  ]
}
