{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node", "mocha", "vscode"],
    "rootDir": ".",
    "outDir": "out/types/electron",
    "tsBuildInfoFile": "out/types/.tsbuildinfo/electron.tsbuildinfo"
  },
  "include": [
    "test/extension.test.mts",
    "test/contributions.test.mts",
    "test/adapter/daemon-runtime.test.mts",
    "test/adapter/document-lifecycle.test.mts",
    "test/adapter/export-ack.test.mts",
    "test/adapter/note-options.test.mts",
    "test/adapter/wiring.test.mts",
    "test/adapter/workspace-selection.test.mts",
    "test/adapter/workspace-migration-runtime.test.mts",
    "test/adapter/multi-root-runtime.test.mts",
    "test/release.test.mts"
  ],
  "references": [{ "path": "./tsconfig.adapter.json" }]
}
