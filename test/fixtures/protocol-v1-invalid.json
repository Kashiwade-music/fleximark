{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "wrong JSON-RPC version",
      "definition": "customRequest",
      "value": {
        "jsonrpc": "1.0",
        "id": 7,
        "method": "fleximark/getNoteOptions",
        "params": {
          "daemonInstanceId": "daemon",
          "workspaceUri": "file:///workspace"
        }
      }
    },
    {
      "name": "response error code is not numeric",
      "definition": "response",
      "value": {
        "jsonrpc": "2.0",
        "id": 7,
        "error": { "code": "-32801", "message": "content modified" }
      }
    },
    {
      "name": "negative nested selection position",
      "definition": "customNotification",
      "value": {
        "jsonrpc": "2.0",
        "method": "fleximark/setSelection",
        "params": {
          "daemonInstanceId": "daemon",
          "documentSessionId": "document",
          "expectedDocumentVersion": 3,
          "selections": [
            {
              "anchor": { "line": -1, "character": 0 },
              "active": { "line": 0, "character": 0 }
            }
          ]
        }
      }
    },
    {
      "name": "malformed nested preview navigation position",
      "definition": "renderPublication",
      "value": {
        "type": "full",
        "previewSessionId": "preview",
        "documentVersion": 3,
        "resultRenderRevision": 1,
        "rendererFingerprint": "sha256:renderer",
        "nodeIds": ["document-root"],
        "navigation": [
          {
            "nodeId": "document-root",
            "sourceRange": {
              "byteStart": 0,
              "byteEnd": 0,
              "start": { "line": 0, "character": 0, "encoding": "bytes" },
              "end": { "line": 0, "character": 0, "encoding": "utf8" }
            },
            "depth": 0
          }
        ],
        "style": null,
        "assets": [],
        "html": "<main data-fleximark-node-id=\"document-root\"></main>"
      }
    },
    {
      "name": "malformed nested patch precondition",
      "definition": "renderPublication",
      "value": {
        "type": "patch",
        "previewSessionId": "preview",
        "documentVersion": 4,
        "baseRenderRevision": 1,
        "resultRenderRevision": 2,
        "baseRendererFingerprint": "sha256:renderer",
        "resultRendererFingerprint": "sha256:renderer",
        "navigation": [],
        "style": null,
        "operations": [
          {
            "type": "remove",
            "nodeId": "document-root",
            "parentId": "document-root",
            "precondition": {
              "nodeExists": "yes",
              "currentParentId": "document-root"
            }
          }
        ]
      }
    },
    {
      "name": "unknown nested source navigation event",
      "definition": "customNotification",
      "value": {
        "jsonrpc": "2.0",
        "method": "fleximark/previewEvent",
        "params": {
          "daemonInstanceId": "daemon",
          "previewSessionId": "preview",
          "renderRevision": 1,
          "event": {
            "type": "selectSource",
            "sourceRange": {
              "byteStart": 0,
              "byteEnd": 3,
              "start": { "line": 0, "character": 0, "encoding": "invalid" },
              "end": { "line": 0, "character": 3, "encoding": "utf8" }
            }
          }
        }
      }
    }
  ]
}
